{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "rootDir": "./specs",
    "outDir": "dist",
    "baseUrl": ".",
    "ignoreDeprecations": "5.0"
  },
  "include": ["specs/**/*"]
}
